{
  "name": "pi-quiet-ask",
  "version": "0.2.0",
  "description": "TypeSafe Jev as the pi coding agent's quiet decision layer: a rule engine of declarative packs (gate tool calls, judge command output, classify intent, catch unverified 'done' claims, detect retry loops), a task graph HUD, triage of pi-ask questions the conversation already answers, and a reviewable history of every decision",
  "license": "MIT",
  "author": "HyunjunJeon <jeonhj920@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/HyunjunJeon/pi-quiet-ask"
  },
  "homepage": "https://github.com/HyunjunJeon/pi-quiet-ask#readme",
  "bugs": "https://github.com/HyunjunJeon/pi-quiet-ask/issues",
  "keywords": [
    "pi-package",
    "pi-extension",
    "typesafe",
    "jev",
    "system-one",
    "coding-agent",
    "guardrails",
    "rule-engine",
    "pi-ask"
  ],
  "type": "module",
  "files": [
    "extensions",
    "skills",
    "README.md",
    "README.ko.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": ["./extensions/quiet-ask/index.ts"],
    "skills": ["./skills"]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  }
}
